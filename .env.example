# Copy this file to ".env" (same folder) and fill in your local values.
# .env is gitignored — never commit real credentials.

# development | testing | production (used by Phinx)
APP_ENV=development
# Set to true only while debugging locally — raw PHP errors then display.
APP_DEBUG=false
APP_TIMEZONE=Africa/Nairobi

DB_HOST=localhost
DB_NAME=brightframe_db
DB_USER=root
DB_PASS=
DB_PORT=3306
# Seconds to wait for MySQL before treating it as unavailable.
DB_TIMEOUT=5

# Where form notifications get sent (quote + contact forms)
ADMIN_EMAIL=jairusonkundi@gmail.com

# SMTP relay for PHPMailer — see includes/mailer.php.
# SMTP_PASS must be a Gmail App Password (requires 2-Step Verification on
# the account) — NOT the account's normal sign-in password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=jairusonkundi@gmail.com
SMTP_PASS=PASTE_YOUR_GMAIL_APP_PASSWORD_HERE
MAIL_FROM=jairusonkundi@gmail.com
MAIL_FROM_NAME=Brightframe Technologies

# Company branding (used in hero slider, footer, etc.)
COMPANY_NAME=Brightframe Technologies
COMPANY_SLOGAN=Frame Your Business Brightly