# Copy this file to ".env" (same folder) and fill in your local values.
# .env is gitignored — never commit real credentials.

DB_HOST=localhost
DB_NAME=brightframe_db
DB_USER=root
DB_PASS=
DB_PORT=3306

# Where contact-form notifications get sent
ADMIN_EMAIL=hello@brightframesoftware.com

# Used as the "From" address when sending mail() notifications.
# On most local XAMPP setups outgoing mail is NOT configured — see README.
MAIL_FROM=no-reply@brightframesoftware.local
